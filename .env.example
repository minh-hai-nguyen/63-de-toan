# Sao chép file này thành .env và điền giá trị thật.

# ── Cơ sở dữ liệu ─────────────────────────────────────────────
# Dev (mặc định): SQLite
DATABASE_URL="file:./dev.db"
# Prod: dùng PostgreSQL (vd Neon) — đồng thời đổi provider trong
# prisma/schema.prisma thành "postgresql":
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ── Auth.js (NextAuth) ────────────────────────────────────────
# Tạo chuỗi bí mật: npx auth secret   (hoặc bất kỳ chuỗi ngẫu nhiên dài)
AUTH_SECRET="thay-bang-chuoi-ngau-nhien"
# Khi deploy, đặt domain thật:
# AUTH_URL="https://ten-mien-cua-ban"
