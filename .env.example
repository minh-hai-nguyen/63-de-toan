# Sao chép file này thành .env và điền giá trị thật.

# ── Cơ sở dữ liệu ─────────────────────────────────────────────
# Dev (mặc định): SQLite
DATABASE_URL="file:./dev.db"
# Prod: dùng PostgreSQL (vd Neon) — đồng thời đổi provider trong
# prisma/schema.prisma thành "postgresql":
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ── Auth.js (NextAuth) ────────────────────────────────────────
# Tạo chuỗi bí mật: npx auth secret   (hoặc bất kỳ chuỗi ngẫu nhiên dài)
AUTH_SECRET="thay-bang-chuoi-ngau-nhien"
# Khi deploy, đặt domain thật:
# AUTH_URL="https://ten-mien-cua-ban"

# ── AI (tuỳ chọn) ─────────────────────────────────────────────
# Trợ lý AI + AI nhận xét tự luận dùng Google Gemini (có gói MIỄN PHÍ).
# Lấy key miễn phí tại https://aistudio.google.com/apikey (không cần thẻ).
# Bỏ trống = tắt tính năng AI (web vẫn chạy bình thường).
GEMINI_API_KEY=""
# Đổi model nếu muốn (mặc định gemini-2.5-flash — miễn phí):
# GEMINI_MODEL="gemini-2.5-flash"
